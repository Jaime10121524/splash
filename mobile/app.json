{
  "expo": {
    "name": "Splash Next",
    "slug": "splash-mobile",
    "scheme": "splashmobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ahritech.splashnext",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ahritech.splashnext",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o Splash Next utilize a câmera para ler os QR Codes de agendamentos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-share",
        {
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Splash escolha fotos para o perfil e o registro de vendas.",
          "cameraPermission": "Permitir que o Splash tire fotos do perfil e das vendas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7861F9",
          "defaultChannel": "splash_avisos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
