# PHP / CodeIgniter
/backend/vendor/
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/writable/*
!/backend/writable/.gitkeep
/backend/.phpunit.cache/
/backend/phpunit.xml

# React / Vite
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
/frontend/.vite/

# Android / Capacitor (arquivos locais)
**/android/.gradle/
**/android/local.properties
**/android/**/build/

# Segredos / temporários / editor
.env
.env.*
!.env.example
*.log
*.sql
*.sql.gz
*.bak
*.zip
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# HostGator: pacotes de instalação gerados localmente
/deploy/_saida_hostgator/

# Credenciais nativas Firebase/Apple e assinatura Android
/frontend/android/app/google-services.json
/frontend/ios/App/App/GoogleService-Info.plist
/frontend/android/*.keystore
/frontend/android/*.jks
/frontend/**/*.p12
/frontend/**/*.mobileprovision
