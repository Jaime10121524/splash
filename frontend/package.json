    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
